{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cortex Governed Memory Challenge fixture v0.1",
  "description": "Public test-sequence schema; malformed-input tests intentionally permit arbitrary body objects. The API contract in API.md defines valid requests. No internal storage schema is exposed.",
  "type": "object",
  "required": [
    "version",
    "id",
    "synthetic",
    "steps"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "synthetic": {
      "const": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/v1/challenge/(records|query|reset|result/receipt-[a-z0-9-]+)$"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "session": {
          "enum": [
            "a",
            "b"
          ]
        },
        "body": {
          "type": "object"
        },
        "raw": {
          "type": "string",
          "maxLength": 8193
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "expected_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "expected": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "RETURN",
                "HOLD",
                "DENY",
                "HISTORICAL",
                "SUPERSEDED",
                "UNRESOLVED"
              ]
            },
            "record_id": {
              "type": "string"
            },
            "temporal_status": {
              "type": "string"
            },
            "provenance_present": {
              "type": "boolean"
            },
            "reason_category": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "save": {
          "type": "string"
        },
        "same_as": {
          "type": "string"
        },
        "receipt_from": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "const": "restart"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "steps",
            "expected_decisions"
          ],
          "properties": {
            "action": {
              "const": "parallel"
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/request"
              }
            },
            "expected_decisions": {
              "type": "array",
              "items": {
                "enum": [
                  "RETURN",
                  "HOLD",
                  "DENY"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
